# 复制为 .env 并按需修改
# cp .env.example .env

# PostgreSQL 连接串（docker-compose.yaml 默认账号）
DATABASE_URL="postgresql://nest_user:nest_password@localhost:5432/nest_db"

# 服务端口（默认 3000；前端 rewrite 代理通常指向 3001）
PORT=3001

# better-auth 签名密钥（生产环境务必用强随机值）
BETTER_AUTH_SECRET="please-change-me"

# 后端自身对外地址（cookie 域名绑定用）
BETTER_AUTH_URL="http://localhost:3001"

# 前端跨域来源（better-auth 据此注入 CORS）
FRONTEND_URL="http://localhost:3000"